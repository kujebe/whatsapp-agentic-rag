# ==============================================================================
# Layer 1 Environment Contract: Multi-Tenant WhatsApp Hybrid Architecture
# ==============================================================================

# Project & Namespace (Change per company: ogabassey, fintech_client, retail_brand)
COMPOSE_PROJECT_NAME=whatsapp
TENANT_ID=ogabassey

# Host Port Bindings (Change if running multiple instances on one host)
N8N_HOST_PORT=5678
BAILEYS_HOST_PORT=3000

# n8n Storage Volume
# Set to 'n8n_data' for your existing local setup; change for clean new clients
N8N_EXISTING_VOLUME=n8n_data

# Redis Security
REDIS_PASSWORD=change_me_super_secure_random_hex_32

# Inbound Debounce Window (ms)
DEBOUNCE_MS=3500

# Logging
LOG_LEVEL=info

# n8n External Webhook URL
N8N_PUBLIC_WEBHOOK_URL=http://localhost:5678/

# Timezone (e.g. Africa/Lagos, America/New_York, Europe/London)
GENERIC_TIMEZONE=Africa/Lagos


# ==============================================================================
# Layer 3 Environment Contract: n8n Hybrid Engine & Client Catalog Assets
# ==============================================================================
# Client Data Paths (inside n8n container, resolved dynamically by TENANT_ID)
TENANT_CONFIG_PATH=/data/clients/ogabassey/data/config.json
TENANT_CATALOG_PATH=/data/clients/ogabassey/data/catalog.json
TENANT_FAQ_PATH=/data/clients/ogabassey/data/faq.json

# Sales Desk Routing
SALES_REP_JID=2347014278724@s.whatsapp.net
SALES_REP_FALLBACK_JID=2348146978921@s.whatsapp.net

# End-of-Day Cron Trigger (UTC cron format; 19:00 UTC = 20:00 WAT, Mon-Sat)
EOD_CRON_WAT="0 19 * * 1-6"

# Layer 4 Fallback LLM Gateway (Modal vLLM / OpenAI compatible)
LLM_BASE_URL=
LLM_MODEL=Qwen/Qwen2.5-7B-Instruct
LLM_API_KEY=
LLM_TIMEOUT_MS=4000
TENANT_SYSTEM_PROMPT="You are OgaBassey's friendly and accurate WhatsApp sales assistant. You help customers with gadget prices, trade-in questions, store location in Ikeja Lagos, delivery terms via GIG Logistics, and warranty information. Always give short, direct answers in Nigerian business context. Never make up prices not found in the catalog."

# Multimodal Gateway (Modal Vision & Whisper endpoints)
MODAL_VISION_URL=
MODAL_WHISPER_URL=
